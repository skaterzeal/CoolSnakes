default_platform(:ios)

platform :ios do
  desc "Build and upload Cool Snakes to TestFlight"
  lane :beta do
    raw_key = ENV['APP_STORE_CONNECT_API_KEY_BASE64'].to_s.gsub("\x00", "").strip
    key_id = ENV['APP_STORE_CONNECT_API_KEY_ID'].to_s.gsub("\x00", "").strip
    issuer_id = ENV['APP_STORE_CONNECT_API_ISSUER_ID'].to_s.gsub("\x00", "").strip

    if key_id.empty? || issuer_id.empty? || raw_key.empty?
      UI.user_error!("Missing App Store Connect API Key environment variables")
    end

    # Handle all formats: raw PEM, base64-encoded, literal \n, Windows CRLF, or flattened string
    s = raw_key.gsub('\\n', "\n").gsub('\\r', "").gsub("\r", "")

    # If it does not contain 'BEGIN', attempt to base64-decode
    if !s.include?("BEGIN")
      begin
        candidate = Base64.decode64(s).gsub("\x00", "").strip
        if candidate.include?("BEGIN")
          s = candidate.gsub('\\n', "\n").gsub('\\r', "").gsub("\r", "")
        end
      rescue => e
        UI.message("Base64 decode note: #{e.message}")
      end
    end

    # Extract base64 body (strip headers, footers, and non-base64 characters)
    body = s
      .gsub(/-----BEGIN[A-Z0-9_ ]+-----/i, "")
      .gsub(/-----END[A-Z0-9_ ]+-----/i, "")
      .gsub(/[^A-Za-z0-9+\/=]/, "")

    # Reconstruct standard PEM with 64-character lines
    formatted_pem = "-----BEGIN PRIVATE KEY-----\n" + body.scan(/.{1,64}/).join("\n") + "\n-----END PRIVATE KEY-----\n"

    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, formatted_pem)

    UI.message("Authenticating with App Store Connect API (Key ID: #{key_id})...")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    keychain_name = "coolsnakes_ci_keychain"
    keychain_password = "ci_temp_password_123"
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # Create and unlock temporary CI keychain
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Ensure the new keychain is in the macOS user keychain search list
    sh "security list-keychains -d user -s #{keychain_db} $(security list-keychains -d user | tr -d '\"')"
    sh "security default-keychain -s #{keychain_db}"
    sh "security unlock-keychain -p #{keychain_password} #{keychain_db}"

    # Install Apple Worldwide Developer Relations (WWDR) G3 and G6 Intermediate CA certificates
    # (Without these, macOS Keychain considers any distribution certificate as 'Unknown Authority' / Invalid)
    UI.message("Installing Apple WWDR Intermediate CA certificates...")
    sh "curl -fsSL https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o /tmp/AppleWWDRCAG3.cer"
    sh "security import /tmp/AppleWWDRCAG3.cer -k #{keychain_db} -A"
    sh "curl -fsSL https://www.apple.com/certificateauthority/AppleWWDRCAG6.cer -o /tmp/AppleWWDRCAG6.cer"
    sh "security import /tmp/AppleWWDRCAG6.cer -k #{keychain_db} -A"

    # 1. Certificates
    if ENV['APPLE_CERTIFICATE_BASE64'] && !ENV['APPLE_CERTIFICATE_BASE64'].empty?
      UI.message("Importing manually provided Apple Distribution Certificate (.p12)...")
      cert_b64 = ENV['APPLE_CERTIFICATE_BASE64'].to_s.gsub("\x00", "").strip
      cert_path = "/tmp/build_cert.p12"
      File.binwrite(cert_path, Base64.decode64(cert_b64))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV['APPLE_CERTIFICATE_PASSWORD'] || "coolsnakes123",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      # Print available code signing identities to CI log for verification
      sh "security find-identity -v -p codesigning #{keychain_db} || true"
    else
      UI.message("Checking existing certificates on Apple Developer account...")
      begin
        require 'spaceship'
        Spaceship::ConnectAPI.token = api_key

        dist_types = [
          Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
          Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
        ]

        existing_certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
          dist_types.include?(c.certificate_type)
        end

        UI.message("Found #{existing_certs.count} existing Distribution Certificate(s) on Apple Developer Portal.")

        while existing_certs.count >= 2
          oldest = existing_certs.sort_by { |c| c.expiration_date.to_s }.first
          UI.important("Certificate limit reached (#{existing_certs.count}/2). Automatically revoking oldest certificate: #{oldest.name} (#{oldest.id}) to make room...")
          oldest.delete!
          existing_certs.delete(oldest)
          UI.success("✅ Successfully revoked #{oldest.id} via API!")
        end
      rescue => e
        UI.message("Certificate auto-cleanup note: #{e.message}")
      end

      UI.message("Fetching or creating Apple Distribution Certificate via App Store Connect API...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_db,
        keychain_password: keychain_password
      )

      # Export newly generated certificate and key as .p12 backup
      begin
        FileUtils.mkdir_p("../../build")
        sh "security export -k #{keychain_db} -t identities -f pkcs12 -P 'coolsnakes123' -o ../../build/coolsnakes_distribution.p12"
        UI.success("Created backup Distribution Certificate (.p12) in build directory")
      rescue => e
        UI.message("P12 backup note: #{e.message}")
      end
    end

    # 2. Provisioning Profile
    if ENV['PROVISIONING_PROFILE_BASE64'] && !ENV['PROVISIONING_PROFILE_BASE64'].empty?
      UI.message("Installing manually provided Provisioning Profile...")
      pp_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/coolsnakes.mobileprovision")
      FileUtils.mkdir_p(File.dirname(pp_path))
      File.write(pp_path, Base64.decode64(ENV['PROVISIONING_PROFILE_BASE64']))
    else
      UI.message("Downloading/creating App Store Provisioning Profile for com.coolsnakes.app...")
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.coolsnakes.app",
        keychain_path: keychain_db,
        force: true
      )
    end

    # 3. Build Flutter IPA
    UI.message("Building Release IPA using Flutter...")
    sh "cd ../.. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist"

    # 4. Upload to TestFlight
    UI.message("Uploading IPA to App Store Connect / TestFlight...")
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("🎉 Cool Snakes successfully uploaded to TestFlight!")
  end
end
